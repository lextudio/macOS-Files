<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <Nullable>enable</Nullable>
        <IsTrimmable>true</IsTrimmable>
        <Configurations>Debug;Release</Configurations>
        <Platforms>x86;x64;arm64</Platforms>
        <RuntimeIdentifiers>osx-x64;osx-arm64</RuntimeIdentifiers>
        <IsAotCompatible>true</IsAotCompatible>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>Files.Platform.MacOS</RootNamespace>
    </PropertyGroup>

    <!--  OS-neutral/POSIX code comes from Files.Platform.Posix; the macOS-only implementations live here.  -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.Logging" />
        <PackageReference Include="SkiaSharp" />
        <PackageReference Include="SkiaSharp.NativeAssets.macOS" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Files.Platform.Abstractions\Files.Platform.Abstractions.csproj" />
        <ProjectReference Include="..\Files.Platform.Posix\Files.Platform.Posix.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Files.Platform.Posix" />
        <Using Include="Files.Platform.Posix.AppData" />
        <Using Include="Files.Platform.Posix.Archives" />
        <Using Include="Files.Platform.Posix.Elevation" />
        <Using Include="Files.Platform.Posix.Enumeration" />
        <Using Include="Files.Platform.Posix.FileOperations" />
        <Using Include="Files.Platform.Posix.FileStat" />
        <Using Include="Files.Platform.Posix.Icons" />
        <Using Include="Files.Platform.Posix.Launching" />
        <Using Include="Files.Platform.Posix.Mime" />
        <Using Include="Files.Platform.Posix.Native" />
        <Using Include="Files.Platform.Posix.Permissions" />
        <Using Include="Files.Platform.Posix.Previews" />
        <Using Include="Files.Platform.Posix.Search" />
        <Using Include="Files.Platform.Posix.Thumbnails" />
        <Using Include="Files.Platform.Posix.Volumes" />
        <Using Include="Files.Platform.Posix.Watching" />
    </ItemGroup>
</Project>
