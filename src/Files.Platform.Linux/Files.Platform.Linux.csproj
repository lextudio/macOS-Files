<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <Nullable>enable</Nullable>
        <IsTrimmable>true</IsTrimmable>
        <Configurations>Debug;Release</Configurations>
        <Platforms>x86;x64;arm64</Platforms>
        <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
        <IsAotCompatible>true</IsAotCompatible>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.Logging" />
        <PackageReference Include="SharpCompress" />
        <PackageReference Include="SkiaSharp" />
        <PackageReference Include="Svg.Skia" />
        <PackageReference Include="Tmds.DBus.Protocol" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Files.Platform.Abstractions\Files.Platform.Abstractions.csproj" />
        <ProjectReference Include="..\Files.Platform.Posix\Files.Platform.Posix.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Files.Platform.Tests" />
    </ItemGroup>

    <Import Project="..\Files.Platform.Posix\PosixGlobalUsings.props" />
</Project>
