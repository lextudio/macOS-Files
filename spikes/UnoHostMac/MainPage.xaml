<Page
    x:Class="UnoHostMac.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UnoHostMac"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="12" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            FontSize="20"
            Text="Files on Uno — macOS spike" />

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="8">
            <TextBox
                x:Name="PathBox"
                Width="320"
                PlaceholderText="Type a path"
                AutomationProperties.AutomationId="PathBox"
                Text="/Users" />
            <Button
                x:Name="GoButton"
                AutomationProperties.AutomationId="GoButton"
                Click="GoButton_Click"
                Content="Go" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="ready" />
        </StackPanel>

        <ListView
            x:Name="ItemList"
            Grid.Row="2"
            AutomationProperties.AutomationId="ItemList"
            ItemsSource="{x:Bind Items}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SampleItem">
                    <TextBlock Text="{x:Bind Name}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
